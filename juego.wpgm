import objetos.*
import wollok.game.*
import jugador.*
import sonidos.*
import niveles.*
import estadoDelJuego.*

program Bomberman {
	game.title("Grupo: Herencia de Problemas | Bomberman")
	game.height(10)
	game.width(15)

	juego.nivelActual(nivel1) // Acá pueden cambiar el nivel que se juega, que puede ser el mapaPrueba o nivel1
	juego.cargarNivel()

	game.start()
}