import objetos.*
import wollok.game.*
import jugador.*

program NombreDeJuego {
	game.title("Grupo: Herencia de Problemas | Bomberman")
	game.height(10)
	game.width(10)
	game.boardGround("Fondo.jpg")
	game.addVisual(jugador)

	keyboard.up().onPressDo({ jugador.subir() })
	keyboard.down().onPressDo({ jugador.bajar() })
	keyboard.left().onPressDo({ jugador.irALaIzquierda() })
	keyboard.right().onPressDo({ jugador.irALaDerecha() })

	keyboard.q().onPressDo({ game.addVisual(new Bomba(position = jugador.position())) })

	game.start()
}
