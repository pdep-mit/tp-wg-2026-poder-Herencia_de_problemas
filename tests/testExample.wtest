import jugador.*
import objetos.*


describe "test de movimiento y colisiones de jugador" {

  method initialize(){
    game.clear()
    jugador.position(game.at(1,1))
    jugador.estaVivo(true) //inicializo el estado del jugador como vivo
    game.addVisual(jugador)
  }

  test "el jugador se mueve libremente a una casilla vacia " {
    jugador.subir()
    assert.equals(game.at(1,2), jugador.position())
  }
  test "el jugador no puede avanzar si hay un muro destruible" {
    const muro = new MuroDestruible(position = game.at(1, 2))
    game.addVisual(muro)
    jugador.subir()

    assert.equals(game.at(1,1), jugador.position())
    
  }
  test "el jugador no puede avanzar si hay una bomba" {
    const bomba = new Bomba(position = game.at(2,1))
    game.addVisual(bomba)

    assert.equals(game.at(1,1), jugador.position())
    
  }
  test "el jugador no puede salir de los limites del mapa hacia la izquierda" {
    jugador.position(game.at(0,1))
    jugador.irALaIzquierda()
    assert.equals(game.at(0,1), jugador.position()) // valor esperado comparado con el valor actual
    
  }

}

describe "test de explosion" {
  method initialize(){
    game.clear()
    jugador.position(game.at(1,1))
    jugador.estaVivo(true) //inicializo el estado del jugador como vivo
    game.addVisual(jugador)
  }
  test "Si al jugador le queda 1 vida la explosion lo mata" {
    const posicion = game.at(2,2)
    const bomba = new Bomba(position = posicion)

    jugador.position(posicion.right(1))
    jugador.estaVivo(true)
    jugador.vidas(1)
    game.addVisual(bomba)

    bomba.explotar()
    game.flushEvents(100)

    assert.notThat(jugador.estaVivo())
}
  test "la explosion destruye el muro destruible" {
    const muroDestruible = new MuroDestruible(position = game.at(1, 2))
    const bomba = new Bomba(position = game.at(1, 1))
    
    game.addVisual(muroDestruible)
    game.addVisual(bomba)
    
    bomba.explotar() 
    game.flushEvents(100)
    
    assert.notThat(game.hasVisual(muroDestruible))
  }
  test "la explosion no afecta al muro indestruible" {
    const muroIndestruible = new MuroIndestruible(position = game.at(2, 1))
    const bomba = new Bomba(position = game.at(1, 1))
    
    game.addVisual(muroIndestruible)
    game.addVisual(bomba)
    
    bomba.explotar() 
    game.flushEvents(100)
    
    assert.that(game.hasVisual(muroIndestruible))
  }
  test "la explosion destruye el muro destruible y no afecta al indestructible" {
    const muroDestruible = new MuroDestruible(position = game.at(1, 2))
    const muroIndestructible = new MuroIndestruible(position = game.at(2, 1))
    const bomba = new Bomba(position = game.at(1, 1))
    
    game.addVisual(muroDestruible)
    game.addVisual(muroIndestructible)
    game.addVisual(bomba)
    
    bomba.explotar() 
    game.flushEvents(100)
    
    assert.notThat(game.hasVisual(muroDestruible))
    assert.that(game.hasVisual(muroIndestructible))
  }
}