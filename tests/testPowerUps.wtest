import objetos.*
import jugador.*
import enemigos.*
import estadoDelJuego.*


describe "Test de PowerUps"{

    test "Si el jugador agarro un multiplicador, obtiene el doble de puntos del enemigo horizontal " {
        marcadorDePuntaje.reiniciar()
        const multiplicador = new MultiplicadorPowerUp(position = game.at(1,2) )
        multiplicador.chocarConJugador()
        const enemigo = new EnemigoHorizontal(position = game.at(2,2))
        game.addVisual(enemigo)
        enemigo.recibirExplosion()
        
        assert.equals(enemigo.puntos() * 2, marcadorDePuntaje.puntos())
    }

    test "Si el jugador agarro un multiplicador, obtiene el doble de puntos del enemigo fantasma " {
        marcadorDePuntaje.reiniciar()
        const multiplicador = new MultiplicadorPowerUp(position = game.at(1,2) )
        multiplicador.chocarConJugador()
        const enemigo = new EnemigoFantasma(position = game.at(2,2))
        game.addVisual(enemigo)
        enemigo.recibirExplosion()
        
        assert.equals(enemigo.puntos() * 2, marcadorDePuntaje.puntos())
    }

    test "Si el jugador agarro un escudo, este le bloquea al recibir daño"{
        const escudo = new EscudoPowerUp(position = game.at(1,2) )
        escudo.chocarConJugador()
        jugador.recibirDanio()

        assert.equals(3, jugador.vidas())
    }
    test "Si el jugador NO agarro un escudo, recibe daño normalmente"{
        jugador.recibirDanio()

        assert.equals(3 - 1, jugador.vidas())
    }
    test "Si el jugador agarro un escudo, este le bloquea el primer ataque pero no el segundo"{
        const escudo = new EscudoPowerUp(position = game.at(1,2) )
        escudo.chocarConJugador()
        2.times({a => jugador.recibirDanio()})

        assert.equals(3 - 1, jugador.vidas())
    }
    test "Si el jugador NO agarro un PowerUp MasBombas, este puede tirar solo 3 bombas" {
        assert.equals(3, jugador.maxBombas())
    }
    test "Si el jugador agarro un PowerUp MasBombas, este puede tirar 1 bomba más (4 bombas)" {
        const powerBomba = new MasBomba(position = game.at(2, 2) )
        powerBomba.chocarConJugador()

        assert.equals(4, jugador.maxBombas())
    }
    
    test "Si el jugador tiene PowerUps y reinicia el nivel, estos desaparecen del jugador" {
        const multiplicador = new MultiplicadorPowerUp(position = game.at(2, 2))
        const escudo = new EscudoPowerUp(position = game.at(2, 2) )
        const masBombas = new MasBomba(position = game.at(2, 2) )
        [multiplicador,escudo,masBombas].forEach({ p => p.chocarConJugador() })
        juego.reiniciarJuego()

        assert.that(jugador.powerUps().isEmpty())
    }
    test "Si el jugador esta en el nivel 1 y tiene powerUps, al pasar al siguiente nivel NO los pierde" {
        const multiplicador = new MultiplicadorPowerUp(position = game.at(2, 2))
        const escudo = new EscudoPowerUp(position = game.at(2, 2) )
        const masBombas = new MasBomba(position = game.at(2, 2) )
        [multiplicador,escudo,masBombas].forEach({ p => p.chocarConJugador() })
        juego.pasarANivel2()

        assert.notThat(jugador.powerUps().isEmpty())
    }
    
}