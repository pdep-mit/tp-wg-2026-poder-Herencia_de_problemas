import niveles.*
import jugador.*
import objetos.*
import estadoDelJuego.*
import enemigos.*

describe "daño al jugador"{
      method initialize(){
    game.clear()
    jugador.position(game.at(1,1))
    jugador.vidas(3) // Inicializamos las vidas en lugar de modificar "estaVivo"
    game.addVisual(jugador)
  }
  test "cuando el jugador recibe danio, pierde una vida y sigue vivo"{
    jugador.recibirDanio()
    assert.equals(2, jugador.vidas())
    assert.that(jugador.estaVivo())
  }

  test "jugador recibe 3 golpes y muere"{
    jugador.recibirDanio()
    jugador.recibirDanio()
    jugador.recibirDanio()
    assert.equals(0, jugador.vidas())
    assert.notThat(jugador.estaVivo())
  }
  test "si el jugador ya esta muerto y recibe un golpe, lanza un error" {
    3.times{a => jugador.recibirDanio()}
    assert.throwsException({ jugador.recibirDanio()})
  }
    test "la explosion de una bomba le saca una vida al jugador" {
 const bomba = new Bomba(position = game.at(1, 1))
  game.addVisual(bomba)
  bomba.explotar()
   game.flushEvents(100)
  assert.equals(2, jugador.vidas())
  assert.that(jugador.estaVivo())
}
test "cuando el jugador pierde una vida, el corazon 3 se ve vacio" {
  const corazon = new Corazon(numero = 3)
  jugador.recibirDanio()
  assert.equals("imagenes/corazonNegro.png", corazon.image())
}
test "Al reiniciar el nivel con R, el jugador vuelve a tener 3 vidas"{
  game.clear()
  juego.cargarNivel()
  jugador.recibirDanio()
  jugador.recibirDanio()
   jugador.recibirDanio()
   juego.recargarNivel()
   assert.equals(3, jugador.vidas())
}
test "Si el jugador muere en el nivel 2, al apretar R vuelve al nivel 1"{
  game.clear()
  juego.nivelActual(nivel2)
  juego.cargarNivel()
  juego.recargarNivel()
  assert.equals(nivel1, juego.nivelActual())
}
}


describe "Test de puntos de enemigos" {

  test "Los puntos del marcador deben iniciar en 0"{
    assert.equals(0, marcadorDePuntaje.puntos())
  }

  test "Matar un enemigo horizontal suma 200 puntos" { 
        marcadorDePuntaje.reiniciar()
        const enemigo = new EnemigoHorizontal(position = game.at(2,2))
        game.addVisual(enemigo)
        enemigo.recibirExplosion()
        
        assert.equals(enemigo.puntos(), marcadorDePuntaje.puntos())
  }

  test "Matar un fantasma suma 800 puntos" {
        marcadorDePuntaje.reiniciar()
        const enemigo = new EnemigoFantasma(position = game.at(2,2))
        game.addVisual(enemigo)
        enemigo.recibirExplosion()
        
        assert.equals(enemigo.puntos(), marcadorDePuntaje.puntos())
  }

  test "Al reiniciar el juego (Apretando la R) los puntos se deben reiniciar a 0"{
        marcadorDePuntaje.puntos(1000)
        juego.recargarNivel()

        assert.equals(0, marcadorDePuntaje.puntos())
  }
}

