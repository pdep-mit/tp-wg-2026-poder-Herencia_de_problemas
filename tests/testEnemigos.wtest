import jugador.*
import objetos.*

describe "daño al jugador"{
      method initialize(){
    game.clear()
    jugador.position(game.at(1,1))
    jugador.estaVivo(true) //inicializo el estado del jugador como vivo
    game.addVisual(jugador)
  }
  test "cuando el jugador recibe danio, pierde una vida y sigue vivo"{
    jugador.recibirDanio()
    assert.equals(2, jugador.vidas())
    assert.that(jugador.estaVivo())
  }

  test "jugador recibe 3 golpes y muere"{
    jugador.recibirDanio()
    jugador.recibirDanio()
    jugador.recibirDanio()
    assert.equals(0, jugador.vidas())
    assert.notThat(jugador.estaVivo())
  }
  test "si el jugador ya esta muerto, las vidas no bajan de 0" {
    jugador.recibirDanio()
    jugador.recibirDanio()
    jugador.recibirDanio()
    jugador.recibirDanio()
    assert.equals(0, jugador.vidas())
    assert.notThat(jugador.estaVivo())
  }
    test "la explosion de una bomba le saca una vida al jugador" {
 const bomba = new Bomba(position = game.at(1, 1))
  game.addVisual(bomba)
  bomba.explotar()
   game.flushEvents(100)
  assert.equals(2, jugador.vidas())
  assert.that(jugador.estaVivo())
}
}
